import React, { useEffect, useState } from "react";
import httpClient from "../httpClient";
import { getUserPortfolio } from "../portfolioService";

function Home() {
  const [user, setUser] = useState(null);
  const [portfolio, setPortfolio] = useState(null);

  const logoutUser = async () => {
    await httpClient.post("//52.4.229.0:5555/logout");
    window.location.href = "/";
  };

  useEffect(() => {
    (async () => {
      try {
        const resp = await httpClient.get("//52.4.229.0:5555/@me");
        setUser(resp.data);

        // Fetch the portfolio data if the user is logged in
        const portfolioData = await getUserPortfolio();
        setPortfolio(portfolioData);
      } catch (error) {
        console.log("Not authenticated");
      }
    })();
  }, []);

  return (
    <div>
      <h1>Welcome to this React Application</h1>
      {user != null ? (
        <div>
          <h2>Logged in</h2>
          <h3>ID: {user.id}</h3>
          <h3>Email: {user.email}</h3>

          <button onClick={logoutUser}>Logout</button>

          {/* Display portfolio data if available */}
          {portfolio ? (
            <div>
              <h2>Portfolio</h2>
              <p>Total Invested: ${portfolio.total_invested}</p>
              <p>Total Return: ${portfolio.total_return}</p>
              <p>Percentage Up: {portfolio.percentage_up}%</p>

              {/* Example to display stock data */}
              {Object.keys(portfolio.stock_data).map((stock, index) => (
                <div key={index}>
                  <h3>{portfolio.stock_data[stock].longName}</h3>
                  <p>Current Price: ${portfolio.stock_data[stock].current_price}</p>
                  <p>Performance: {portfolio.stock_data[stock].performance}</p>
                  {/* Add more details as needed */}
                </div>
              ))}
            </div>
          ) : (
            <p>Loading portfolio...</p>
          )}
        </div>
      ) : (
        <div>
          <p>You are not logged in</p>
          <div>
            <a href="/login">
              <button>Login</button>
            </a>
            <a href="/register">
              <button>Register</button>
            </a>
          </div>
        </div>
      )}
    </div>
  );
}

export default Home;

