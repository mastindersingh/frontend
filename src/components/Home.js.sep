import React, { useEffect, useState } from "react";
import httpClient from "../httpClient";
import StockTransaction from "./StockTransaction"; 
import { Link } from "react-router-dom"; // Import Link from react-router-dom

function Home() {
  const [user, setUser] = useState(null);
  const [portfolio, setPortfolio] = useState(null);

  const logoutUser = async () => {
    await httpClient.post("//52.4.229.0:5555/logout");
    window.location.href = "/";
  };

  useEffect(() => {
    (async () => {
      try {
        const userResp = await httpClient.get("//52.4.229.0:5555/@me");
        setUser(userResp.data);

        // Fetch the portfolio data if the user is logged in
        const portfolioResp = await httpClient.get("//52.4.229.0:5555/api/user_portfolio");
        setPortfolio(portfolioResp.data);
      } catch (error) {
        console.log("Not authenticated");
      }
    })();
  }, []);

  return (
    <div>
      <h1>Welcome to this React Application</h1>
      {user != null ? (
        <div>
          <h2>Logged in</h2>
          <h3>ID: {user.id}</h3>
          <h3>Email: {user.email}</h3>

          <button onClick={logoutUser}>Logout</button>

          {/* Display portfolio data if available */}
          {portfolio ? (
            <div>
              <h2>Portfolio</h2>
              <p>Total Invested: ${portfolio.total_invested}</p>
              <p>Total Return: ${portfolio.total_return}</p>

              {/* Display stock data */}
              <h3>Stocks</h3>
              {portfolio.stocks && portfolio.stocks.length > 0 ? (  // Check if stocks exist and have length > 0
                portfolio.stocks.map((stock, index) => (
                  <div key={index}>
                    <p>Symbol: {stock.symbol}</p>
                    <p>Quantity: {stock.quantity}</p>
                    <p>Purchase Price: ${stock.purchase_price}</p>
                  </div>
                ))
              ) : (
                <p>No stocks available in your portfolio.</p>  // Fallback if no stocks are found
              )}

              {/* Buy and Sell Stock Buttons */}
              <div>
                <Link to="/buy-stock">
                  <button>Buy Stock</button>
                </Link>
                <Link to="/sell-stock">
                  <button>Sell Stock</button>
                </Link>
              </div>
            </div>
          ) : (
            <p>Loading portfolio...</p>
          )}
        </div>
      ) : (
        <div>
          <p>You are not logged in</p>
          <div>
            <Link to="/login">
              <button>Login</button>
            </Link>
            <Link to="/register">
              <button>Register</button>
            </Link>
          </div>
        </div>
      )}
    </div>
  );
}

export default Home;

